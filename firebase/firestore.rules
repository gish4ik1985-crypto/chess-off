rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function myRole() {
      return exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        ? get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role : 'player';
    }
    function isAdmin() {
      return request.auth.token.email in ['gish4ik1985@gmail.com'] || myRole() == 'admin';
    }

    function isTeacher() {
      return isAdmin() || myRole() == 'coach' || myRole() == 'moderator';
    }

    // Ник занимается один раз при регистрации: документ nicks/{ник} создаётся только если его ещё нет,
    // менять и удалять его нельзя. Так два игрока не получат один ник.
    match /nicks/{nick} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && nick == nick.lower()
        && nick.size() >= 2 && nick.size() <= 60;
      allow update, delete: if false;
    }

    // Публичная карточка игрока: видят все вошедшие, пишет только хозяин и только под своим ником.
    match /players/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nick', 'rating', 'title', 'games', 'cups', 'age', 'seen', 'avatar', 'hidden', 'city', 'about', 'rank', 'key', 'name', 'group'])
        && (!('name' in request.resource.data) || request.resource.data.name.size() <= 60)
        && (!('about' in request.resource.data) || request.resource.data.about.size() <= 80)
        && (!('city' in request.resource.data) || request.resource.data.city.size() <= 30)
        && request.resource.data.nick is string
        && request.resource.data.nick.size() >= 2 && request.resource.data.nick.size() <= 60
        && request.resource.data.key is string
        && request.resource.data.key.size() == request.resource.data.nick.size()
        && get(/databases/$(database)/documents/nicks/$(request.resource.data.key)).data.uid == uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 0 && request.resource.data.rating <= 3500;
      allow delete: if false;
    }

    // Роли: ученик / тренер / модератор / администратор. Читают все вошедшие. Администратор (и адреса из
    // списка ниже — они администраторы с самого начала) назначает любые роли; тренер и модератор могут
    // менять только именной титул, не трогая роль.
    match /roles/{target} {
      function targetRole() {
        return exists(/databases/$(database)/documents/roles/$(target))
          ? get(/databases/$(database)/documents/roles/$(target)).data.role : 'player';
      }

      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['role', 'award', 'nick', 'by', 'at'])
        && request.resource.data.role in ['player', 'coach', 'moderator', 'admin']
        && request.resource.data.award is string && request.resource.data.award.size() <= 40
        && (isAdmin()
          || ((myRole() == 'coach' || myRole() == 'moderator') && request.resource.data.role == targetRole()));
      allow delete: if false;
    }

    // Домашние задания: создают и меняют только учителя (тренер, модератор, администратор); читают все вошедшие.
    match /assignments/{aid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && isTeacher()
        && request.resource.data.keys().hasOnly(['title', 'text', 'kind', 'metric', 'target', 'fen', 'solution',
                                                 'deadline', 'group', 'active', 'by', 'by_name', 'created'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 60
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000;
      allow delete: if request.auth != null && isTeacher();
    }

    // Сданная работа: ученик пишет только свою (документ «задание_uid»), читают все вошедшие.
    match /submissions/{sid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && sid == request.resource.data.aid + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['aid', 'uid', 'name', 'group', 'score', 'detail', 'comment', 'at'])
        && request.resource.data.comment.size() <= 300;
      allow delete: if false;
    }

    // Оценка и комментарий учителя к сданной работе.
    match /reviews/{rid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && isTeacher()
        && request.resource.data.keys().hasOnly(['aid', 'uid', 'grade', 'note', 'by', 'at'])
        && request.resource.data.note.size() <= 200;
      allow delete: if false;
    }

    // Записи партий, которыми поделились: пишет автор, удалить может автор или учитель.
    match /gamebook/{gid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['title', 'pgn', 'by', 'by_name', 'at'])
        && request.resource.data.pgn.size() <= 12000;
      allow delete: if request.auth != null && (resource.data.by == request.auth.uid || isTeacher());
    }

    // Турниры школы. Турнир, жеребьёвку и ручные записи ведёт учитель; ученик пишет только свою заявку и
    // ходы в своих партиях.
    match /ctourneys/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && isTeacher()
        && request.resource.data.keys().hasOnly(['name', 'kind', 'rounds', 'tc', 'status', 'round', 'nplayers', 'players', 'by', 'by_name', 'created'])
        && request.resource.data.name.size() <= 60;
      allow delete: if request.auth != null && isTeacher();
    }
    match /centries/{eid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && eid == request.resource.data.tid + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['tid', 'uid', 'name', 'at']);
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isTeacher());
    }
    match /cgames/{gid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isTeacher()
        && request.resource.data.keys().hasOnly(['tid', 'round', 'wuid', 'wname', 'buid', 'bname', 'fen', 'moves', 'turn', 'status', 'result', 'reason', 'wtime', 'btime', 'last', 'tc', 'draw', 'pgn', 'at']);
      allow update: if request.auth != null
        && (isTeacher() || request.auth.uid == resource.data.wuid || request.auth.uid == resource.data.buid)
        && request.resource.data.tid == resource.data.tid
        && request.resource.data.wuid == resource.data.wuid
        && request.resource.data.buid == resource.data.buid
        && request.resource.data.keys().hasOnly(['tid', 'round', 'wuid', 'wname', 'buid', 'bname', 'fen', 'moves', 'turn', 'status', 'result', 'reason', 'wtime', 'btime', 'last', 'tc', 'draw', 'pgn', 'at'])
        && request.resource.data.pgn.size() <= 12000;
      allow delete: if request.auth != null && isTeacher();
    }

    // Чат: комнаты «school» (общий), «grp_…» (группа) и «dm_…» (личные, в названии — uid обоих). Писать можно
    // только от своего имени; удалять — своё сообщение или учителю.
    match /chat/{room}/msgs/{mid} {
      function canUseRoom() {
        return room == 'school' || room.matches('grp_.*') || room.matches('dm_.*' + request.auth.uid + '.*');
      }
      allow read: if request.auth != null && canUseRoom();
      allow create: if request.auth != null && canUseRoom()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'at'])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 300;
      allow update: if false;
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isTeacher());
    }

    // Расписание, события и годовой план: видят все вошедшие, пишет только учитель.
    match /events/{eid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && isTeacher()
        && request.resource.data.keys().hasOnly(['title', 'kind', 'date', 'time', 'time_end', 'weekday', 'place', 'text', 'group', 'by', 'by_name', 'at'])
        && request.resource.data.kind in ['lesson', 'event', 'tournament', 'plan']
        && request.resource.data.title.size() <= 80 && request.resource.data.text.size() <= 1000;
      allow delete: if request.auth != null && isTeacher();
    }

    // Объявления учителя.
    match /announcements/{nid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && isTeacher()
        && request.resource.data.keys().hasOnly(['title', 'text', 'group', 'pinned', 'until', 'by', 'by_name', 'at'])
        && request.resource.data.title.size() <= 80 && request.resource.data.text.size() <= 2000;
      allow delete: if request.auth != null && isTeacher();
    }

    // Задачник учителя: заметки и задачи видит и правит только их владелец (и только учитель).
    match /tnotes/{tid} {
      allow read: if request.auth != null && isTeacher() && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null && isTeacher() && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['owner', 'kind', 'title', 'text', 'done', 'due', 'at']);
      allow update: if request.auth != null && isTeacher() && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['owner', 'kind', 'title', 'text', 'done', 'due', 'at']);
      allow delete: if request.auth != null && isTeacher() && resource.data.owner == request.auth.uid;
    }

    // Полный профиль (статистика ходов, сильные и слабые стороны): только хозяин.
    match /private/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
