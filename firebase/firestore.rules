rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Ник занимается один раз при регистрации: документ nicks/{ник} создаётся только если его ещё нет,
    // менять и удалять его нельзя. Так два игрока не получат один ник.
    match /nicks/{nick} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && nick == nick.lower()
        && nick.size() >= 2 && nick.size() <= 24;
      allow update, delete: if false;
    }

    // Публичная карточка игрока: видят все вошедшие, пишет только хозяин и только под своим ником.
    match /players/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nick', 'rating', 'title', 'games', 'cups', 'age', 'seen', 'avatar', 'hidden', 'city', 'about', 'rank'])
        && (!('about' in request.resource.data) || request.resource.data.about.size() <= 80)
        && (!('city' in request.resource.data) || request.resource.data.city.size() <= 30)
        && request.resource.data.nick is string
        && request.resource.data.nick.size() >= 2 && request.resource.data.nick.size() <= 24
        && get(/databases/$(database)/documents/nicks/$(request.resource.data.nick.lower())).data.uid == uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 0 && request.resource.data.rating <= 3500;
      allow delete: if false;
    }

    // Полный профиль (статистика ходов, сильные и слабые стороны): только хозяин.
    match /private/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
