rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Публичная карточка игрока: видят все вошедшие, пишет только хозяин.
    match /players/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nick', 'rating', 'title', 'games', 'cups', 'age', 'seen'])
        && request.resource.data.nick is string
        && request.resource.data.nick.size() >= 1 && request.resource.data.nick.size() <= 24
        && request.resource.data.rating is number
        && request.resource.data.rating >= 0 && request.resource.data.rating <= 3500;
      allow delete: if false;
    }

    // Полный профиль (статистика ходов, сильные и слабые стороны): только хозяин.
    match /private/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
