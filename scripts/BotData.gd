# Форматы товарищеской партии — те же контроли времени, что и в турнирах,
# чтобы игрок тренировал знакомый режим. tc — секунд на партию (0 = без
# часов), inc — добавка за ход.
const MATCH_FORMATS := [
	{"id": "classic", "name": "Классика", "hint": "без часов — думайте сколько хотите", "tc": 0, "inc": 0},
	{"id": "rapid15", "name": "Рапид 15+10", "hint": "15 минут и +10 сек за ход", "tc": 900, "inc": 10},
	{"id": "rapid10", "name": "Рапид 10+5", "hint": "10 минут и +5 сек за ход", "tc": 600, "inc": 5},
	{"id": "blitz5", "name": "Блиц 5+3", "hint": "5 минут и +3 сек за ход", "tc": 300, "inc": 3},
	{"id": "blitz3", "name": "Блиц 3+2", "hint": "3 минуты и +2 сек за ход", "tc": 180, "inc": 2},
]

static func format_by_id(id: String) -> Dictionary:
	for f in MATCH_FORMATS:
		if f.id == id:
			return f
	return MATCH_FORMATS[0]

const PER_LEAGUE := 15

# Рабочие границы рейтинга внутри лиги. У крайних лиг формальные границы
# бесполезны (у нижней min = 0, у верхней max = 99999), поэтому там берём
# осмысленные значения — иначе игроки размазались бы по пустому диапазону.
static func league_band(league_idx: int) -> Dictionary:
	var i = clampi(league_idx, 0, LEAGUES.size() - 1)
	var l: Dictionary = LEAGUES[i]
	return {
		"lo": float(l.min) if i > 0 else 300.0,
		"hi": float(l.max) if i < LEAGUES.size() - 1 else 1650.0,
	}

# Потолок для СЛАБОГО бота: нижняя половина его лиги. Ограничивать всей лигой
# мало — тогда слабый бот со временем доползает до верха и перестаёт быть тем
# самым «запасным соперником», ради которого он и заведён.
# Насколько далеко ОБЫЧНЫЙ бот может уйти от своей родной лиги. Без предела
# состав со временем расползается по краям и средние лиги пустеют, а турнир
# там становится не из кого собрать. Две лиги вверх и вниз — достаточно, чтобы
# история «вырос и ушёл из твоей лиги» случалась, но состав оставался живым.
const DRIFT_LEAGUES := 2

static func drift_bounds(home_idx: int) -> Dictionary:
	var lo_idx = clampi(home_idx - DRIFT_LEAGUES, 0, LEAGUES.size() - 1)
	var hi_idx = clampi(home_idx + DRIFT_LEAGUES, 0, LEAGUES.size() - 1)
	return {"lo": float(league_band(lo_idx).lo), "hi": float(league_band(hi_idx).hi)}

static func weak_ceiling(league_idx: int) -> float:
	var b := league_band(league_idx)
	return float(b.lo) + (float(b.hi) - float(b.lo)) * 0.45

# Сколько всего игроков в базе.
static func count() -> int:
	return NAMES.size()

# Полное описание бота по его порядковому номеру. Всё детерминировано от
# индекса, поэтому карточка одного и того же бота всегда одинакова.
static func bot_def(idx: int) -> Dictionary:
	var i = clampi(idx, 0, NAMES.size() - 1)
	var league_idx = mini(i / PER_LEAGUE, LEAGUES.size() - 1)
	var league: Dictionary = LEAGUES[league_idx]
	var in_league = i % PER_LEAGUE
	# каждый 10-й — слабый: ровно 10% состава, и хотя бы один в каждой лиге
	var weak = (i % 10) == 4
	var band := league_band(league_idx)
	var lo = float(band.lo)
	var hi = float(band.hi)
	# слабые садятся в нижнюю треть своей лиги, остальные распределены ровно
	var t = (float(in_league) + 0.5) / float(PER_LEAGUE)
	if weak:
		t = t * 0.3
	return {
		"id": "bot_%03d" % i,
		"idx": i,
		"name": NAMES[i],
		"league": league.id,
		"league_idx": league_idx,
		"home_league_idx": league_idx,
		"base_rating": lo + (hi - lo) * t,
		"weak": weak,
		"style": STYLES[(i * 3 + league_idx) % STYLES.size()],
	}

static func all_defs() -> Array:
	var out := []
	for i in range(NAMES.size()):
		out.append(bot_def(i))
	return out

static func def_by_id(id: String) -> Dictionary:
	var i = id.replace("bot_", "").to_int()
	if id.begins_with("bot_") and i >= 0 and i < NAMES.size():
		return bot_def(i)
	return {}

# Лига по рейтингу.
static func league_idx_for_rating(r: float) -> int:
	for i in range(LEAGUES.size()):
		if r <= float(LEAGUES[i].max):
			return i
	return LEAGUES.size() - 1

static func league_for_rating(r: float) -> Dictionary:
	return LEAGUES[league_idx_for_rating(r)]

static func league_by_id(id: String) -> Dictionary:
	for l in LEAGUES:
		if l.id == id:
			return l
	return LEAGUES[0]

# Короткая подпись лиги для карточек и списков.
static func league_label(r: float) -> String:
	var l = league_for_rating(r)
	return "%s %s" % [l.icon, l.name]
