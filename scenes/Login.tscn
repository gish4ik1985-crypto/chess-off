[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/Login.gd" id="1"]
[ext_resource type="Theme" path="res://theme/NeonTheme.tres" id="2"]

[node name="Login" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme = ExtResource("2")
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
mouse_filter = 2
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.02, 0.02, 0.05, 1)

[node name="CenterPanel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -250.0
offset_top = -220.0
offset_right = 250.0
offset_bottom = 220.0

[node name="VBox" type="VBoxContainer" parent="CenterPanel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TitleLabel" type="Label" parent="CenterPanel/VBox"]
layout_mode = 2
text = "ШАХМАТЫ"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 34
theme_override_colors/font_color = Color(0.1, 0.95, 1, 1)

[node name="SubtitleLabel" type="Label" parent="CenterPanel/VBox"]
layout_mode = 2
text = "Кто играет?"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(1, 0.65, 0.95, 1)

[node name="HSeparator" type="HSeparator" parent="CenterPanel/VBox"]
layout_mode = 2

[node name="UsersScroll" type="ScrollContainer" parent="CenterPanel/VBox"]
custom_minimum_size = Vector2(0, 120)
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="UserList" type="VBoxContainer" parent="CenterPanel/VBox/UsersScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="EmptyLabel" type="Label" parent="CenterPanel/VBox"]
layout_mode = 2
text = "Пока нет ни одного игрока — создайте профиль ниже"
horizontal_alignment = 1
autowrap_mode = 2
theme_override_font_sizes/font_size = 12
theme_override_colors/font_color = Color(0.55, 0.6, 0.7, 1)

[node name="StorageNote" type="Label" parent="CenterPanel/VBox"]
layout_mode = 2
text = "Профили хранятся на этом устройстве. Перенос на другое — Настройки → «Сохранить профиль»."
horizontal_alignment = 1
autowrap_mode = 2
theme_override_font_sizes/font_size = 12
theme_override_colors/font_color = Color(0.55, 0.6, 0.7, 1)

[node name="NewUserButton" type="Button" parent="CenterPanel/VBox"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
text = "+ Новый игрок"

[connection signal="pressed" from="CenterPanel/VBox/NewUserButton" to="." method="_open_new_user_window"]
